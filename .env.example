# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Bitrix24 Integration
# Получить URL: Битрикс24 → Приложения → Вебхуки → Входящий вебхук
# Права: crm (чтение/запись)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX_ENABLED=false

# Calendly (опционально, если используете внешний календарь)
CALENDLY_URL=https://calendly.com/your-link
